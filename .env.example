# ==============================================================================
# GALURA SLIMS ENVIRONMENT & DEPLOYMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Application Environment
APP_ENV=production

# VPS Deployment Target (SSH Credentials)
DEPLOY_SSH_IP=43.159.63.105
DEPLOY_SSH_USER=ubuntu
DEPLOY_SSH_KEY=/Users/admin/.ssh/vps_baru.key
DEPLOY_DOCKER_NETWORK=galura_app

# GitHub Container Registry (GHCR) Configuration
GHCR_USERNAME=galura-it-solution
GHCR_TOKEN=your_ghcr_token_here
DEPLOY_IMAGE_REPO=ghcr.io/galura-it-solution/galura-slims
DEPLOY_IMAGE_TAG=latest

# Database Root Credentials
DB_USER=root
DB_PASS=your_db_password_here

# ------------------------------------------------------------------------------
# ZONE 1: SLiMS EDU (Domain: slims-edu.galura.id)
# ------------------------------------------------------------------------------
DEPLOY_PORT_EDU=8081
DEPLOY_CONTAINER_PORT_EDU=80
DEPLOY_DB_PORT_EDU=3307
DB_NAME_EDU=senayan_edu
DB_PASS_EDU=your_edu_db_password_here
DEPLOY_IMAGE_EDU=ghcr.io/galura-it-solution/galura-slims-edu:latest

# ------------------------------------------------------------------------------
# ZONE 2: SLiMS EBOOK (Domain: slims-ebook.galura.id)
# ------------------------------------------------------------------------------
DEPLOY_PORT_EBOOK=8082
DEPLOY_CONTAINER_PORT_EBOOK=80
DEPLOY_DB_PORT_EBOOK=3308
DB_NAME_EBOOK=senayan_ebook
DB_PASS_EBOOK=your_ebook_db_password_here
DEPLOY_IMAGE_EBOOK=ghcr.io/galura-it-solution/galura-slims-ebook:latest
